{
  "name": "@context/mobile",
  "version": "0.5.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:native": "expo run:ios",
    "web": "expo start --web",
    "build:preview:android": "npx eas-cli build --platform android --profile preview",
    "build:preview:ios": "npx eas-cli build --platform ios --profile preview",
    "build:preview-simulator:ios": "npx eas-cli build --platform ios --profile preview-simulator",
    "build:production:ios": "npx eas-cli build --platform ios --profile production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export:ios": "expo export --platform ios",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@context/shared": "*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.7",
    "expo-camera": "~57.0.6",
    "expo-contacts": "~57.0.7",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.1",
    "expo-local-authentication": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
