{
  "name": "@context/mobile",
  "version": "0.5.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:native": "expo run:ios",
    "web": "expo start --web",
    "build:preview:android": "npx eas-cli build --platform android --profile preview",
    "build:preview:ios": "npx eas-cli build --platform ios --profile preview",
    "build:preview-simulator:ios": "npx eas-cli build --platform ios --profile preview-simulator",
    "build:production:ios": "npx eas-cli build --platform ios --profile production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export:ios": "expo export --platform ios",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@context/shared": "*",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~57.0.22",
    "expo-camera": "~57.0.4",
    "expo-contacts": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.1",
    "expo-local-authentication": "~57.0.3",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/react": "^19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
