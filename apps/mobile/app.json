{
  "expo": {
    "name": "Context — Relationship Memory",
    "slug": "context-memory-aid",
    "version": "0.4.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "context",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Context uses the camera only while you scan an event badge. Camera frames are not stored.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F6F4EE"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hackathon.contextmemory"
    },
    "android": {
      "package": "com.hackathon.contextmemory",
      "allowBackup": false,
      "permissions": ["CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
