{
  "$schema": "https://expo.dev/eas-build/schema.json",
  "cli": {
    "version": ">=20.5.1",
    "requireCommit": true,
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true
    }
  }
}
