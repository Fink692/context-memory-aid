{
  "name": "context-memory-aid",
  "version": "0.5.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "pnpm --filter @context/mobile run start",
    "build:desktop:macos": "pnpm --filter @context/mobile run export:web -- --clear && ./apps/desktop-macos/build-macos.sh",
    "dev:watcher": "node tools/update-watcher.mjs serve",
    "check:updates": "node tools/update-watcher.mjs check",
    "install:update-task": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/install-monthly-update-task.ps1",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test && node --test tools/update-watcher.test.mjs tools/local-model.test.mjs",
    "verify": "pnpm run typecheck && pnpm run test",
    "audit": "pnpm audit --audit-level=high"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "react-native-safe-area-context": "5.7.0",
    "uuid": "11.1.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.1.5",
    "@rolldown/binding-darwin-x64": "1.1.5",
    "@rolldown/binding-linux-x64-gnu": "1.1.5",
    "lightningcss-darwin-arm64": "1.32.0",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
