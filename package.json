{
  "name": "context-memory-aid",
  "version": "0.4.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm --workspace @context/mobile run start",
    "dev:watcher": "node tools/update-watcher.mjs serve",
    "check:updates": "node tools/update-watcher.mjs check",
    "install:update-task": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/install-monthly-update-task.ps1",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test tools/update-watcher.test.mjs",
    "verify": "npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "react-native-safe-area-context": "5.7.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.1.5"
  }
}
